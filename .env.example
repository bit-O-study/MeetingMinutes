# ── 데이터베이스 ────────────────────────────────────────────
# 로컬 Postgres 또는 Neon 연결 문자열
# Neon: https://console.neon.tech 에서 프로젝트 생성 후 복사
DATABASE_URL="postgresql://user:password@localhost:5432/meeting_minutes"

# ── 인증 (Auth.js v5) ──────────────────────────────────────
# 생성: npx auth secret   또는   openssl rand -base64 32
AUTH_SECRET=""

# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── 앱 ─────────────────────────────────────────────────────
# 초대 링크·공유 링크의 절대 URL 생성에 쓴다
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 공동 편집 WebSocket 주소. 비우면 현재 호스트를 사용한다.
NEXT_PUBLIC_COLLAB_URL=""
