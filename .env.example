# ── 데이터베이스 ────────────────────────────────────────────
# 운영은 서버 내부 PostgreSQL, 개발은 SSH 터널의 루프백 포트를 사용한다.
# 루프백 외 주소는 TLS 필수. 접속 비밀번호를 저장소에 커밋하지 않는다.
DATABASE_URL="postgresql://user:password@localhost:5432/meeting_minutes"

# 내부 DB 개발 연결: 설정하면 npm run dev가 SSH 터널을 자동으로 준비한다.
# DATABASE_URL의 호스트/포트는 127.0.0.1:15433으로 지정한다.
DATABASE_SSH_HOST=""
DATABASE_SSH_USER="pc"
DATABASE_SSH_KEY=""
DATABASE_SSH_HOST_KEY_ALIAS=""
DATABASE_SSH_LOCAL_PORT="15433"
DATABASE_SSH_REMOTE_PORT="5433"

# ── 인증 (Auth.js v5) ──────────────────────────────────────
# 생성: npx auth secret   또는   openssl rand -base64 32
AUTH_SECRET=""

# 이메일·비밀번호 가입을 사용하므로 Google OAuth 설정은 필요하지 않다.

# ── 앱 ─────────────────────────────────────────────────────
# 초대 링크·공유 링크의 절대 URL 생성에 쓴다. Vercel에서는 비워 두면 운영 도메인을 사용한다.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 공동 편집 WebSocket 주소.
# 비워 두면 개발은 ws://localhost:1234 (npm run collab), 배포는 같은 호스트의
# /api/collab 라우트로 붙는다. 별도 서버를 따로 띄운 경우에만 채운다.
NEXT_PUBLIC_COLLAB_URL=""

# 통합 어드민(heltch-admin)이 /api/stats 를 읽을 때 쓰는 비밀 토큰(24자 이상). 어드민의 MEMO_STATS_TOKEN 과 같은 값.
STATS_API_TOKEN=""

# Windows/직접 호스팅의 영구 업로드 경로(절대 경로). 릴리스 폴더 밖에 두고 DB와 함께 백업한다.
# 개발에서는 비어 있으면 .data/uploads 사용. 운영에서는 필수. Vercel 임시 디스크에는 업로드하지 않는다.
MOA_UPLOAD_DIR=""
