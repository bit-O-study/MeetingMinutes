# ── 데이터베이스 ────────────────────────────────────────────
# 로컬 Postgres 또는 Neon 연결 문자열
# Neon: https://console.neon.tech 에서 프로젝트 생성 후 복사
DATABASE_URL="postgresql://user:password@localhost:5432/meeting_minutes"

# ── 인증 (Auth.js v5) ──────────────────────────────────────
# 생성: npx auth secret   또는   openssl rand -base64 32
AUTH_SECRET=""

# 이메일·비밀번호 가입을 사용하므로 Google OAuth 설정은 필요하지 않다.

# ── 앱 ─────────────────────────────────────────────────────
# 초대 링크·공유 링크의 절대 URL 생성에 쓴다. Vercel에서는 비워 두면 운영 도메인을 사용한다.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 공동 편집 WebSocket 주소.
# 비워 두면 개발은 ws://localhost:1234 (npm run collab), 배포는 같은 호스트의
# /api/collab 라우트로 붙는다. 별도 서버를 따로 띄운 경우에만 채운다.
NEXT_PUBLIC_COLLAB_URL=""
