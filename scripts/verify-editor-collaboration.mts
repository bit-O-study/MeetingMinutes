import type { Editor } from "@tiptap/core";
import "./load-env.mjs";
import assert from "node:assert/strict";
import { randomUUID, randomBytes } from "node:crypto";
import { inArray, eq } from "drizzle-orm";
import { db, sql } from "../src/lib/db/index.js";
import { users, spaces, spaceMembers, sessions, notes, noteDocs, projectFiles } from "../src/lib/db/schema.js";
import { removeAttachmentFile } from "../src/lib/attachment-storage.js";
import { chromium, type Browser } from "@playwright/test";
const base = process.env.EDITOR_TEST_URL ?? "http://127.0.0.1:3291";
const ids = [randomUUID(), randomUUID()], spaceId = randomUUID(), noteId = randomUUID();
const tokens = [randomBytes(32).toString("hex"), randomBytes(32).toString("hex")];
let browser: Browser | undefined;
try {
  await db.insert(users).values(ids.map((id, i) => ({ id, name: `편집자 ${i + 1}`, email: `collab-${id}@example.invalid` })));
  await db.insert(spaces).values({ id: spaceId, name: "공동 편집 검증", ownerId: ids[0] });
  await db.insert(spaceMembers).values(ids.map((userId, i) => ({ spaceId, userId, role: i ? "member" as const : "owner" as const })));
  await db.insert(sessions).values(ids.map((userId, i) => ({ sessionToken: tokens[i], userId, expires: new Date(Date.now() + 900000) })));
  await db.insert(notes).values({ id: noteId, spaceId, title: "편집 회귀 검증", createdBy: ids[0], template: "blank", content: { type: "doc", content: [{ type: "paragraph", content: [{ type: "text", text: "처음 문단" }] }] } });
  await db.insert(noteDocs).values({ noteId });
  browser = await chromium.launch({ channel: "msedge", headless: true });
  const contexts = await Promise.all(ids.map(() => browser!.newContext()));
  contexts.forEach((ctx) => ctx.setDefaultTimeout(20000));
  const secure = base.startsWith("https:") || process.env.EDITOR_TEST_PRODUCTION === "1";
  await Promise.all(contexts.map((ctx, i) => ctx.addCookies([{ name: secure ? "__Secure-authjs.session-token" : "authjs.session-token", value: tokens[i], domain: new URL(base).hostname, path: "/", secure, httpOnly: true, sameSite: "Lax" }])));
  const pages = await Promise.all(contexts.map((ctx) => ctx.newPage()));
  const errors: string[] = [];
  pages.forEach((p) => p.on("pageerror", (e: Error) => errors.push(e.message)));
  const url = `${base}/s/${spaceId}/n/${noteId}`;
  await pages[0].goto(url, { timeout: 120000 });
  const editor = pages[0].locator('.tiptap[contenteditable="true"]');
  await editor.getByText("처음 문단", { exact: true }).waitFor({ timeout: 60000 });
  await pages[1].goto(url, { timeout: 120000 });
  const peer = pages[1].locator('.tiptap[contenteditable="true"]');
  await peer.getByText("처음 문단", { exact: true }).waitFor({ timeout: 60000 });
  await editor.click(); await pages[0].keyboard.press("Control+End");
  await pages[0].keyboard.insertText(" 동시 편집");
  // 커서 이름표도 문단 안의 DOM 텍스트라 exact text 비교에서 제외한다.
  await peer.locator("p").filter({ hasText: "처음 문단 동시 편집" }).waitFor();
  const label = peer.locator(".collaboration-carets__label", { hasText: "편집자 1" });
  await label.waitFor(); await pages[1].waitForTimeout(3500);
  assert.equal(await label.evaluate((el: HTMLElement) => getComputedStyle(el).opacity), "1");
  assert.notEqual(await label.evaluate((el: HTMLElement) => getComputedStyle(el).backgroundColor), "rgba(0, 0, 0, 0)");
  assert.equal(await pages[1].locator('[title="편집자 1"]').count(), 1);
  console.log("PASS 두 사용자 이름·색상·아바타·3.5초 후 커서 이름 유지");
  const duplicate = await contexts[0].newPage(); await duplicate.goto(url);
  await duplicate.locator('.tiptap[contenteditable="true"]').waitFor();
  assert.equal(await pages[1].locator('[title="편집자 1"]').count(), 1);
  await duplicate.close();
  console.log("PASS 같은 사용자 여러 탭 아바타 중복 없음");
  await editor.click(); await pages[0].keyboard.press("Control+a");
  await editor.evaluate((element: HTMLElement) => {
    const data = new DataTransfer(); data.setData("text/html", '<p>앞 문단</p><p>중간 문단</p><h2>중간 제목</h2><ul><li><p>첫 항목</p></li><li><p>둘째 항목</p></li></ul><p>마지막 문단</p>');
    element.dispatchEvent(new ClipboardEvent("paste", { clipboardData: data, bubbles: true, cancelable: true }));
  });
  await editor.getByText("중간 문단", { exact: true }).click({ position: { x: 12, y: 12 } });
  await pages[0].waitForFunction((text: string) => (document.querySelector('.tiptap[contenteditable="true"]') as (HTMLElement & { editor?: Editor }) | null)?.editor?.state.selection.$from.parent.textContent === text, "중간 문단");
  await pages[0].keyboard.press("Tab"); assert.equal(await editor.locator('p[data-indent="1"]').textContent(), "중간 문단");
  await pages[0].keyboard.press("Shift+Tab"); assert.equal(await editor.locator('p[data-indent]').count(), 0);
  await editor.getByText("중간 제목", { exact: true }).click({ position: { x: 12, y: 12 } });
  await pages[0].waitForFunction((text: string) => (document.querySelector('.tiptap[contenteditable="true"]') as (HTMLElement & { editor?: Editor }) | null)?.editor?.state.selection.$from.parent.textContent === text, "중간 제목"); await pages[0].keyboard.press("Tab");
  assert.equal(await editor.locator('h2[data-indent="1"]').count(), 1);
  await editor.getByText("첫 항목", { exact: true }).click({ position: { x: 12, y: 12 } });
  await pages[0].waitForFunction((text: string) => (document.querySelector('.tiptap[contenteditable="true"]') as (HTMLElement & { editor?: Editor }) | null)?.editor?.state.selection.$from.parent.textContent === text, "첫 항목"); await pages[0].keyboard.press("Tab");
  assert.equal(await editor.evaluate((el: HTMLElement) => el === document.activeElement), true);
  await editor.getByText("둘째 항목", { exact: true }).click({ position: { x: 12, y: 12 } });
  await pages[0].waitForFunction((text: string) => (document.querySelector('.tiptap[contenteditable="true"]') as (HTMLElement & { editor?: Editor }) | null)?.editor?.state.selection.$from.parent.textContent === text, "둘째 항목"); await pages[0].keyboard.press("Tab");
  assert.equal(await editor.locator("ul ul").count(), 1);
  await pages[0].keyboard.press("Shift+Tab"); assert.equal(await editor.locator("ul ul").count(), 0);
  console.log("PASS 문서 중간 문단·제목·목록 Tab/ShiftTab, 첫 항목 포커스 보존");
  await pages[0].getByText(/연결됨 · .* 반영/).waitFor({ timeout: 20000 });
  await pages[0].waitForTimeout(11000);
  assert.match((await pages[0].getByText(/연결됨 · .* 반영/).textContent()) ?? "", /\d+초 전/);
  await editor.getByText("마지막 문단", { exact: true }).click(); await pages[0].keyboard.press("End");
  await pages[0].keyboard.press("Backspace");
  await pages[0].getByText("연결됨 · 저장 확인 중…", { exact: true }).waitFor();
  await pages[0].getByText(/연결됨 · .* 반영/).waitFor({ timeout: 20000 });
  console.log("PASS 유휴 반영시각 유지·초 단위 갱신·삭제만 변경해도 저장 대기/서버 확인");
  const png = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aG1sAAAAASUVORK5CYII=";
  await pages[0].getByLabel("노트 사진 선택").setInputFiles({ name: "검증.png", mimeType: "image/png", buffer: Buffer.from(png, "base64") });
  await editor.locator("img.note-image").waitFor();
  await peer.locator("img.note-image").waitFor();
  assert.equal(await peer.locator("img.note-image").evaluate((img: HTMLImageElement) => img.complete && img.naturalWidth > 0), true);
  await editor.evaluate((element: HTMLElement, encoded: string) => {
    const data = new DataTransfer(); data.items.add(new File([Uint8Array.from(atob(encoded), (c) => c.charCodeAt(0))], "붙여넣기.png", { type: "image/png" }));
    element.dispatchEvent(new ClipboardEvent("paste", { clipboardData: data, bubbles: true, cancelable: true }));
  }, png);
  await pages[0].waitForFunction(() => document.querySelectorAll('[contenteditable="true"] img.note-image').length === 2);
  await editor.evaluate((element: HTMLElement, encoded: string) => {
    const data = new DataTransfer(); data.items.add(new File([Uint8Array.from(atob(encoded), (c) => c.charCodeAt(0))], "드롭.png", { type: "image/png" }));
    const rect = element.getBoundingClientRect();
    element.dispatchEvent(new DragEvent("drop", { dataTransfer: data, clientX: rect.left + 20, clientY: rect.top + 20, bubbles: true, cancelable: true }));
  }, png);
  await pages[0].waitForFunction(() => document.querySelectorAll('[contenteditable="true"] img.note-image').length === 3);
  await pages[0].getByText(/연결됨 · .* 반영/).waitFor({ timeout: 20000 });
  await pages[1].reload();
  await pages[1].waitForFunction(() => document.querySelectorAll('[contenteditable="true"] img.note-image').length === 3);
  console.log("PASS 사진 선택·붙여넣기·드롭·다른 사용자 표시·재접속 보존");
  await contexts[0].setOffline(true);
  await pages[0].getByText("오프라인 · 이 창을 닫지 마세요", { exact: true }).waitFor();
  await editor.click(); await pages[0].keyboard.press("Control+End");
  await pages[0].keyboard.press("Enter"); await pages[0].keyboard.insertText("오프라인 한글 보존");
  assert.equal(await pages[0].getByText(/연결됨 · .* 반영/).count(), 0);
  await contexts[0].setOffline(false);
  await peer.locator("p").filter({ hasText: "오프라인 한글 보존" }).waitFor({ timeout: 30000 });
  await pages[0].getByText(/연결됨 · .* 반영/).waitFor({ timeout: 30000 });
  console.log("PASS 오프라인 입력 보존·반영 오표시 없음·재접속 동기화");
  await pages[0].setViewportSize({ width: 320, height: 800 });
  await pages[0].waitForTimeout(300);
  assert.equal(await pages[0].evaluate(() => document.documentElement.scrollWidth <= window.innerWidth), true);
  console.log("PASS 320px 모바일 가로넘침 없음");
  await pages[1].close();
  await pages[0].waitForFunction(() => !document.querySelector('[title="편집자 2"]'), { timeout: 10000 });
  assert.deepEqual(errors, []);
  console.log("PASS 퇴장 아바타 정리·브라우저 오류 없음");
} catch (error) {
  console.error("EDITOR VERIFY FAILED", error);
  for (const ctx of browser?.contexts() ?? []) { for (const page of ctx.pages()) console.error("EDITOR DOM", await page.locator('.tiptap[contenteditable="true"]').innerHTML().catch(() => "unavailable")); }
  throw error;
} finally {
  await browser?.close();
  // 방 종료 스냅샷이 테스트 행을 되살리거나 외래키 경합을 일으키지 않도록 기다린다.
  await new Promise((resolve) => setTimeout(resolve, 35000));
  const files = await db.select({ id: projectFiles.id }).from(projectFiles).where(eq(projectFiles.spaceId, spaceId));
  for (const file of files) await removeAttachmentFile(file.id);
  await db.delete(spaces).where(eq(spaces.id, spaceId));
  await db.delete(users).where(inArray(users.id, ids));
  await sql.end({ timeout: 5 });
}
